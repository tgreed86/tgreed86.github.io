---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';

const title = 'Publications';
const description = 'Selected publications and research outputs by Trevor Reed.';
---

<BaseLayout {title} {description}>
  <div class="container narrow">
    <PageHeader
      eyebrow="Publications"
      title="Selected publications and research outputs."
      description="Peer-reviewed publications from my experimental nuclear physics training, alongside current scientific machine learning work in progress."
    />

    <section class="publication-group" aria-labelledby="current-work-title">
      <h2 id="current-work-title">Current scientific ML work</h2>
      <article class="notice-box">
        <h2>Graph neural network surrogate modeling for CFD</h2>
        <p>
          Current postdoctoral research focuses on training neural surrogate models on physics simulations
          to reproduce CFD solver behavior at much lower computational cost. Public papers, preprints,
          and technical artifacts will be linked here as they become available.
        </p>
      </article>
    </section>

    <section class="publication-group" aria-labelledby="lead-author-title">
      <h2 id="lead-author-title">Lead author</h2>
      <PublicationItem
        title="Constituent Counting Rule and ω Photoproduction"
        authors="Trevor Reed et al."
        venue="Physical Review C 103, 065203 (2021)"
        note="Representative lead-author publication from Ph.D. research in experimental hadronic physics."
      />
    </section>

    <section class="publication-group" aria-labelledby="selected-collab-title">
      <h2 id="selected-collab-title">Selected collaboration papers</h2>
      <PublicationItem
        title="Improved Λp Elastic Scattering Cross Sections Between 0.9 and 2.0 GeV/c and Connections to the Neutron Star Equation of State"
        authors="J. Rowley et al."
        venue="Physical Review Letters 127, 272303 (2021)"
      />
      <PublicationItem
        title="First Measurement of Timelike Compton Scattering"
        authors="P. Chatagnon et al."
        venue="Physical Review Letters 127, 262501 (2021)"
      />
      <PublicationItem
        title="First CLAS12 Measurement of Deeply Virtual Compton Scattering Beam-Spin Asymmetries in the Extended Valence Region"
        authors="G. Christiaens et al."
        venue="Physical Review Letters 130, 211902 (2023)"
      />
    </section>
  </div>
</BaseLayout>
