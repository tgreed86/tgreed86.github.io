---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const title = 'Projects';
const description = 'Selected software and research projects by Trevor Reed.';

const projects = [
  {
    label: 'Current Focus',
    title: 'GNN-based CFD surrogate modeling',
    description:
      'Training graph neural networks on physics simulation data to reproduce fluid dynamics behavior at inference speeds far below traditional numerical solvers.',
    status: 'Active research',
  },
  {
    label: 'Scientific ML',
    title: 'Simulation dataset pipelines',
    description:
      'Converting CFD and PDE solver output into graph-structured machine learning datasets with reproducible preprocessing, batching, validation, and rollout diagnostics.',
    status: 'Active research',
  },
  {
    label: 'Modeling',
    title: 'Neural methods for physics observables',
    description:
      'Applying autoencoder, variational, and graph-based architectures to compress, reconstruct, and infer structure in high-dimensional scientific data.',
    status: 'Method development',
  },
  {
    label: 'Prior Work',
    title: 'CLAS and CLAS12 analysis infrastructure',
    description:
      'Detector calibration, kinematic reconstruction, covariance modeling, and high-throughput analysis tools from experimental nuclear physics research.',
    status: 'Domain foundation',
  },
];
---

<BaseLayout {title} {description}>
  <div class="container">
    <PageHeader
      eyebrow="Projects"
      title="Selected scientific machine learning and research software."
      description="A focused view of current GNN and simulation-acceleration work, with prior experimental physics software included as evidence of domain depth and production research habits."
    />

    <section class="project-list" aria-label="Selected projects">
      {
        projects.map((project) => (
          <article class="project-card">
            <p class="card-label">{project.label}</p>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <span class="project-status">{project.status}</span>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>
