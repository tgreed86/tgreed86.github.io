---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Trevor Reed';
const description = 'Professional website of Trevor Reed, physicist and scientific machine learning researcher.';
---

<BaseLayout {title} {description}>
  <main>
    <section class="shell" aria-labelledby="page-title">
      <p class="eyebrow">Site foundation</p>
      <h1 id="page-title">Trevor Reed</h1>
      <p class="intro">
        Physicist and scientific machine learning researcher. The full professional website is
        currently under development.
      </p>
      <div class="status" role="status">
        <span class="status-dot" aria-hidden="true"></span>
        Astro and GitHub Pages foundation ready
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 2rem;
  }

  .shell {
    width: min(100%, 52rem);
    padding: clamp(2rem, 6vw, 5rem);
    border: 1px solid #dfe4e5;
    border-radius: 0.75rem;
    background: #ffffff;
    box-shadow: 0 1.5rem 4rem rgb(28 45 52 / 8%);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #52666f;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .intro {
    max-width: 43rem;
    margin: 2rem 0 0;
    color: #44545b;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8ebec;
    color: #52666f;
    font-size: 0.9rem;
  }

  .status-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #2f765e;
    box-shadow: 0 0 0 0.25rem rgb(47 118 94 / 12%);
  }
</style>
