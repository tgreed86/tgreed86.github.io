---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchCard from '../components/ResearchCard.astro';

const title = 'Trevor Reed';
const description = 'Professional website of Trevor Reed, physicist and scientific machine learning researcher.';
---

<BaseLayout {title} {description}>
  <section class="hero container" aria-labelledby="page-title">
    <div class="hero-copy">
      <p class="eyebrow">Professional website prototype</p>
      <h1 id="page-title">Trevor Reed</h1>
      <p class="hero-lede">
        Physicist working across experimental nuclear physics, scientific machine learning, and
        computational methods for data-intensive physics analyses.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/research/">View research</a>
        <a class="button secondary" href="/publications/">Publications</a>
      </div>
    </div>

    <figure class="portrait-card">
      <picture>
        <source srcset="/images/trevor-reed-headshot.webp" type="image/webp" />
        <img src="/images/trevor-reed-headshot.jpg" alt="Trevor Reed standing in a modern academic building" />
      </picture>
      <figcaption>
        <span>Current focus</span>
        Scientific machine learning for physics analysis and simulation workflows.
      </figcaption>
    </figure>
  </section>

  <section class="container section-grid" aria-labelledby="focus-title">
    <div class="section-heading">
      <p class="eyebrow">Research profile</p>
      <h2 id="focus-title">Physics-driven computation for complex experimental data.</h2>
    </div>
    <div class="card-grid three">
      <ResearchCard
        label="Hadronic physics"
        title="Λ(1405) photoproduction"
        description="Cross-section measurements, reaction reconstruction, and CLAS/Jefferson Lab data analysis workflows."
      />
      <ResearchCard
        label="Scientific ML"
        title="Neural methods for physics"
        description="Autoencoders, variational models, and graph neural networks for simulation acceleration and physics inference."
      />
      <ResearchCard
        label="Computing"
        title="Analysis infrastructure"
        description="Python, C++, Java, ROOT, TensorFlow, PyTorch, and HPC workflows for large-scale physics datasets."
      />
    </div>
  </section>

  <section class="container split-panel" aria-labelledby="site-status-title">
    <div>
      <p class="eyebrow">Prototype status</p>
      <h2 id="site-status-title">Design shell ready for review.</h2>
    </div>
    <div>
      <p>
        This version establishes the visual system, navigation, page templates, and headshot treatment.
        The next phase will refine the copy, publication metadata, project descriptions, and external links.
      </p>
      <ul class="check-list">
        <li>Responsive academic-style layout</li>
        <li>Dedicated pages for research, publications, projects, CV, and contact</li>
        <li>Reusable components for cards and publication entries</li>
      </ul>
    </div>
  </section>
</BaseLayout>
