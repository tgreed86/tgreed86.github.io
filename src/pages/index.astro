---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchCard from '../components/ResearchCard.astro';

const title = 'Trevor Reed';
const description =
  'Trevor Reed is a data science postdoc developing graph neural network surrogate models for CFD and physics simulation workflows.';
---

<BaseLayout {title} {description}>
  <section class="hero container" aria-labelledby="page-title">
    <div class="hero-copy">
      <p class="eyebrow">Data Science Postdoc · Scientific Machine Learning</p>
      <h1 id="page-title">Trevor Reed</h1>
      <p class="hero-lede">
        I build graph neural network surrogate models for CFD and physics simulations, with the
        goal of reproducing high-fidelity numerical results in a fraction of the runtime.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/research/">Research focus</a>
        <a class="button secondary" href="/projects/">Selected projects</a>
      </div>
    </div>

    <figure class="portrait-card">
      <picture>
        <source srcset="/images/trevor-reed-headshot.webp" type="image/webp" />
        <img src="/images/trevor-reed-headshot.jpg" alt="Trevor Reed standing in a modern academic building" />
      </picture>
      <figcaption>
        <span>Current focus</span>
        Scientific machine learning for fast, simulation-trained models of complex physical systems.
      </figcaption>
    </figure>
  </section>

  <section class="container section-grid" aria-labelledby="focus-title">
    <div class="section-heading">
      <p class="eyebrow">Research Profile</p>
      <h2 id="focus-title">Scientific ML for physics simulation and accelerated modeling.</h2>
    </div>
    <div class="card-grid three">
      <ResearchCard
        label="Current Work"
        title="GNN surrogates for CFD"
        description="Training mesh- and graph-based neural models on simulation data to approximate fluid dynamics fields, rollouts, and derived observables."
      />
      <ResearchCard
        label="Methods"
        title="Physics-aware ML pipelines"
        description="Simulation dataset generation, graph construction, model validation, uncertainty checks, and HPC workflows for scientific machine learning."
      />
      <ResearchCard
        label="Foundation"
        title="Domain-trained scientist"
        description="Ph.D.-level training in experimental nuclear physics, large-scale data analysis, detector workflows, and computational research software."
      />
    </div>
  </section>

  <section class="container split-panel" aria-labelledby="career-focus-title">
    <div>
      <p class="eyebrow">Career Focus</p>
      <h2 id="career-focus-title">Targeting scientific machine learning and data science roles.</h2>
    </div>
    <div>
      <p>
        I am especially interested in positions where machine learning, numerical simulation,
        and domain science meet: industry research teams, national labs, and applied data science
        groups building fast models for physical systems.
      </p>
      <ul class="check-list">
        <li>Graph neural networks and neural surrogate models for PDE and CFD problems</li>
        <li>Simulation-trained models that reduce the cost of traditional numerical workflows</li>
        <li>Scientific Python, PyTorch, C++, ROOT, and HPC-scale data processing</li>
      </ul>
    </div>
  </section>
</BaseLayout>
