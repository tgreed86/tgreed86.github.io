---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const title = 'CV';
const description = 'Professional background for Trevor Reed in data science, scientific machine learning, and physics.';
---

<BaseLayout {title} {description}>
  <div class="container narrow">
    <PageHeader
      eyebrow="CV"
      title="Scientific machine learning, data science, and physics."
      description="A concise web summary of my current postdoctoral focus, Ph.D. training, and technical background. A downloadable CV will be added once the public version is finalized."
    />

    <section class="timeline" aria-label="Professional background preview">
      <article>
        <span>Current</span>
        <h2>Data Science Postdoctoral Researcher</h2>
        <p>Developing graph neural network surrogate models for CFD and physics simulation workflows, with emphasis on fast inference, robust evaluation, and reproducible scientific ML pipelines.</p>
      </article>
      <article>
        <span>Prior postdoctoral work</span>
        <h2>Experimental Nuclear Physics Researcher</h2>
        <p>Applied machine learning and computational analysis methods to nuclear physics problems, building on collaboration-scale detector and simulation experience.</p>
      </article>
      <article>
        <span>2024</span>
        <h2>Ph.D. in Physics</h2>
        <p>Dissertation research on Λ(1405) photoproduction using CLAS g12 data.</p>
      </article>
      <article>
        <span>2017–2020</span>
        <h2>Teaching Assistant</h2>
        <p>Introductory physics laboratory instruction, office hours, grading, and student support.</p>
      </article>
    </section>

    <div class="notice-box">
      <h2>Core technical strengths</h2>
      <p>
        Scientific machine learning, graph neural networks, CFD/PDE surrogate modeling, simulation
        data pipelines, Python, PyTorch, C++, ROOT, high-performance computing, and physics-driven
        model evaluation.
      </p>
    </div>
  </div>
</BaseLayout>
