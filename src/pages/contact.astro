---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const title = 'Contact';
const description = 'Contact and professional links for Trevor Reed.';
---

<BaseLayout {title} {description}>
  <div class="container narrow">
    <PageHeader
      eyebrow="Contact"
      title="Contact and professional links."
      description="I am open to scientific machine learning and data science opportunities in industry, national labs, and applied research teams."
    />

    <section class="contact-panel">
      <a href="https://github.com/tgreed86">
        <span>GitHub</span>
        github.com/tgreed86
      </a>
      <a href="/cv/">
        <span>CV</span>
        Professional background and technical strengths
      </a>
      <a href="/publications/">
        <span>Publications</span>
        Selected publications and current research outputs
      </a>
    </section>
  </div>
</BaseLayout>
