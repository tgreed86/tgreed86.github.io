---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const title = 'Contact';
const description = 'Contact and professional links for Trevor Reed.';
---

<BaseLayout {title} {description}>
  <div class="container narrow">
    <PageHeader
      eyebrow="Contact"
      title="Contact and professional links."
      description="This page avoids publishing sensitive details until the final contact information is approved."
    />

    <section class="contact-panel">
      <a href="https://github.com/tgreed86">
        <span>GitHub</span>
        github.com/tgreed86
      </a>
      <a href="/cv/">
        <span>CV</span>
        Public CV page pending update
      </a>
      <a href="/publications/">
        <span>Publications</span>
        DOI, arXiv, INSPIRE-HEP, and Scholar links to be added
      </a>
    </section>
  </div>
</BaseLayout>
